{
  "name": "@pcfprio/hiweb-next",
  "version": "0.1.0",
  "description": "Thin Next.js 16 server-only, proxy, BFF, and RSC helpers built on HiWeb core/net.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pcfprio/HiWeb.git",
    "directory": "packages/next"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@pcfprio/hiweb-base": "workspace:*",
    "@pcfprio/hiweb-core": "workspace:*",
    "@pcfprio/hiweb-net": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=16.0.0",
    "react": ">=19.0.0",
    "server-only": ">=0.0.1"
  },
  "exports": {
    "./headers": {
      "types": "./dist/headers.d.ts",
      "import": "./dist/headers.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "import": "./dist/proxy.js"
    },
    "./bff": {
      "types": "./dist/bff.d.ts",
      "import": "./dist/bff.js"
    },
    "./rsc": {
      "types": "./dist/rsc.d.ts",
      "import": "./dist/rsc.js"
    }
  }
}
