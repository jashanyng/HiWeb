{
  "name": "@jashanyng/hiweb-store",
  "version": "0.1.0",
  "description": "SSR-safe, namespaced, schema-validated non-sensitive browser storage for HiWeb.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jashanyng/HiWeb.git",
    "directory": "packages/store"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@jashanyng/hiweb-base": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser-store": {
      "types": "./dist/browser-store.d.ts",
      "import": "./dist/browser-store.js"
    }
  }
}
