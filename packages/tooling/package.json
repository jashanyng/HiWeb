{
  "name": "@jashanyng/hiweb-tooling",
  "version": "0.1.0",
  "description": "Reusable ESLint architectural boundary presets, Prettier presets, and Vitest config helpers for HiWeb.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jashanyng/HiWeb.git",
    "directory": "packages/tooling"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "eslint-plugin-react": ">=7.0.0",
    "prettier": ">=3.0.0",
    "typescript-eslint": ">=8.0.0",
    "vitest": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "eslint-plugin-react": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "exports": {
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "import": "./dist/eslint.js"
    },
    "./prettier": {
      "types": "./dist/prettier.d.ts",
      "import": "./dist/prettier.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js"
    }
  }
}
