{
  "name": "hiweb-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint . && node scripts/check-dep-graph.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "pack:artifacts": "node scripts/pack-artifacts.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run build && pnpm run pack:artifacts && pnpm run verify:pack"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@eslint/js": "9.39.5",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.1",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
